{
  "name": "@vexilla/client",
  "version": "1.0.3",
  "description": "A client for the Vexilla feature flag system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test:gradual": "node --import tsx src/test_gradual.ts",
    "test:scheduling": "node --import tsx src/test_scheduling.ts",
    "test:client": "node --import tsx src/test_client.ts",
    "test": "pnpm run \"/^test:.*/\"",
    "compile": "tsup",
    "test:contract": "node --import tsx --test test/*.test.ts",
    "check:package": "node scripts/check-package.cjs"
  },
  "author": {
    "name": "Chris Griffing",
    "email": "cmgriffing@gmail.com",
    "url": "https://chrisgriffing.com"
  },
  "license": "BUSL-1.1",
  "devDependencies": {
    "@types/node": "^14.14.13",
    "@vexilla/publishing": "workspace:*",
    "@vexilla/types": "workspace:*",
    "axios": "^0.21.0",
    "husky": "^4.3.8",
    "npm-run-all": "^4.1.5",
    "ts-loader": "^8.0.11",
    "ts-node": "^10.9.1",
    "tsup": "^8.0.2",
    "tsx": "4.20.5",
    "typescript": "^5.0.4",
    "uuid": "^8.3.2",
    "xxhashjs": "^0.2.2"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "case": "^1.6.3",
    "dayjs": "^1.11.7"
  },
  "files": [
    "dist/**/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run compile && npm run test"
    }
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "dts": {
      "resolve": true
    },
    "noExternal": [
      "@vexilla/types",
      "@vexilla/publishing"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vexilla/vexilla.git",
    "directory": "clients/js"
  },
  "homepage": "https://vexilla.dev",
  "bugs": {
    "url": "https://github.com/Vexilla/vexilla/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
