{
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:clients:docs:readmes": "ts-node ./scripts/build-client-readmes.ts",
    "build:clients:docs:rust": "(cd clients/rust && cargo doc --no-deps --open)",
    "TODObuild:clients:docs:elixir": "ts-node ./scripts/build-client-readmes.ts",
    "TODObuild:clients:docs:go": "ts-node ./scripts/build-client-readmes.ts",
    "build:clients:docs": "pnpm run \"/^build:clients:docs:.*/\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "contract:generate": "pnpm --filter @vexilla/types build && pnpm --filter @vexilla/publishing build && node --import ./packages/publishing/node_modules/tsx/dist/loader.mjs contract/scripts/generate.ts",
    "contract:test:producer": "pnpm contract:check:blocks && pnpm --filter @vexilla/types check:generated && node contract/scripts/python-requirements.cjs --check && pnpm --filter @vexilla/types test && pnpm --filter @vexilla/publishing test && pnpm --filter app test:publication",
    "contract:check:blocks": "node contract/scripts/check-blocks.cjs",
    "contract:serve": "node contract/scripts/serve.cjs",
    "contract:run": "node contract/scripts/run.cjs",
    "contract:test:gate": "node --test contract/scripts/*.test.cjs",
    "contract:gate": "node contract/scripts/gate.cjs",
    "contract:python:requirements": "node contract/scripts/python-requirements.cjs"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.2",
    "@types/node": "^20.5.8",
    "chalk": "^5.3.0",
    "eslint": "^7.32.0",
    "mustache": "^4.2.0",
    "prettier": "^2.5.1",
    "toml": "^3.0.0",
    "ts-node": "^10.9.1",
    "turbo": "^1.9.3",
    "typescript": "^5.2.2"
  },
  "name": "vexilla",
  "dependencies": {
    "yargs": "^17.5.1"
  },
  "engines": {
    "node": ">=18 <23.0.0",
    "pnpm": ">=8.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "clients/client-js"
  ]
}
