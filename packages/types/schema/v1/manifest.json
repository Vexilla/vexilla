{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vexilla.dev/schema/v1/manifest.json",
  "title": "PublishedManifest",
  "type": "object",
  "required": [
    "version",
    "groups"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "groups": {
      "type": "array",
      "items": {
        "title": "PublishedManifestGroup",
        "type": "object",
        "required": [
          "name",
          "groupId"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
