{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vexilla.dev/schema/v1/schedule.json",
  "title": "PublishedSchedule",
  "type": "object",
  "required": [
    "start",
    "end",
    "startTime",
    "endTime",
    "timezone",
    "timeType"
  ],
  "properties": {
    "start": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "startTime": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "endTime": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "format": "iana-time-zone"
    },
    "timeType": {
      "enum": [
        "none",
        "start/end",
        "daily"
      ]
    }
  },
  "additionalProperties": true
}
