{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "prerelease": false,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "js-types",
      "components": ["client-js", "client-types"],
      "merge": true
    }
  ],
  "packages": {
    "clients/js": {
      "release-type": "node",
      "component": "client-js"
    },
    "packages/types": {
      "release-type": "node",
      "component": "client-types"
    },
    "clients/elixir": {
      "release-type": "elixir",
      "package-name": "vexilla_client",
      "component": "client-elixir"
    },
    "clients/rust": {
      "release-type": "rust",
      "component": "client-rust"
    }
  }
}
